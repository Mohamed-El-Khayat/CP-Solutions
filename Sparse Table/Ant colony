/* اللهم انفعنا بما علمتنا، وعلمنا ما ينفعنا، وزدنا علما. */

#include <bits/stdc++.h>
using namespace std;
#define int ll
typedef long long ll;
#define sz(s) (ll)(s).size()
#define all(s) s.begin(), s.end()

void Speed() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
}

struct sparse {
    vector<vector<int>> data_min;
    vector<vector<int>> data_gcd;
    vector<int> logs;

    int merge_min(int l ,int r) {
        return min(l,r);
    }

    int merge_gcd(int l ,int r) {
        return gcd(l,r);
    }

    sparse(vector<int> &v) {
        int n = v.size();
        logs.assign(n+1, 0);

        for (int i=2 ;i<=n ;i++) {
            logs[i] = logs[i/2] +1;
        }

        data_min.assign(logs[n]+1,vector<int>(n));
        data_gcd.assign(logs[n]+1,vector<int>(n));
        data_min[0] = data_gcd[0] = v;

        for (int i=1 ;i <= logs[n] ;i++) {
            int len = 1 << i;
            for (int j=0 ;j+len <= n ;j++) {
                data_min[i][j] = merge_min(data_min[i-1][j],data_min[i-1][j+(len>>1)]);
                data_gcd[i][j] = merge_gcd(data_gcd[i-1][j],data_gcd[i-1][j+(len>>1)]);
            }
        }
    }

    int get_min(int l, int r) {
        int len = r-l+1;
        int level = logs[len];
        int block_len =   1 << level;
        return merge_min(data_min[level][l],data_min[level][r-block_len+1]);
    }

    int get_gcd(int l, int r) {
        int len = r-l+1;
        int level = logs[len];
        int block_len =   1 << level;
        return merge_gcd(data_gcd[level][l],data_gcd[level][r-block_len+1]);
    }
};
void solve() {
    int n; cin >>n;
    vector<int> v(n);
    map<int,vector<int>> pos;
    for (int i=0 ;i<n;i++) {
        cin >>v[i];
        pos[v[i]] . push_back(i);
    }
    sparse sp(v);
    int q; cin >>q;
    while (q--) {
        int l,r ;cin >>l>>r;
        l--,r--;
        int mn=sp.get_min(l,r);
        int gc=sp.get_gcd(l,r);
        if (mn==gc) {
            int rep = upper_bound(all(pos[mn]),r) - lower_bound(all(pos[mn]),l);
            cout << r-l+1-rep << '\n';
        }
        else {
            cout << r-l+1<<'\n';
        }
    }
}

signed main() {
    Speed();
    //ll t; cin >> t; while (t--)
    solve();
    return 0;
}

